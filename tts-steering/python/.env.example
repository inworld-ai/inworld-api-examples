INWORLD_API_KEY=your_api_key_here
# INWORLD_API_BASE_URL=https://api.inworld.ai
# The streaming example's LLM defaults to the Inworld Router with INWORLD_API_KEY.
# To use another OpenAI-compatible provider instead, set all three:
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=your_llm_api_key_here
# LLM_MODEL=gpt-4.1-mini
